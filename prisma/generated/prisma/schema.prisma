generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  WORKER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum LeadType {
  MEETING
  QUOTATION
  GENERAL
  LANDING
  SYSTEM
  APP
  FOXROOMS
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUOTED
  WON
  LOST
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectType {
  LANDING
  WEBSITE
  SYSTEM
  APP
  BRANDING
  UXUI
  MAINTENANCE
  CONSULTING
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  DELIVERED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum DocumentType {
  COMMERCIAL_PROPOSAL
  SIGNED_CONTRACT
  INVOICE
  PAYMENT_PROOF
  DELIVERABLE
  INTERNAL_FILE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum DemoStatus {
  DEMO_REQUESTED
  DEMO_GIVEN
  FOLLOW_UP
  BETA_USER
  PAYING_CUSTOMER
  LOST
}

// ==========================================
// MODELS
// ==========================================

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean?
  image         String?
  phone         String?
  role          Role       @default(CLIENT)
  status        UserStatus @default(ACTIVE)

  // Better Auth Core
  sessions Session[]
  accounts Account[]

  // Relación con cliente (Si el rol es CLIENT)
  clientId String?
  client   Client? @relation("ClientUsers", fields: [clientId], references: [id], onDelete: SetNull)

  // Relaciones como trabajador responsable
  assignedLeads    Lead[]        @relation("AssignedLeads")
  assignedClients  Client[]      @relation("ResponsibleWorkerClients")
  assignedProjects Project[]     @relation("ResponsibleWorkerProjects")
  uploadedDocs     Document[]    @relation("UploadedDocuments")
  assignedDemos    ProductDemo[] @relation("AssignedDemos")
  activityLogs     ActivityLog[] @relation("ActorLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([clientId])
}

// Better Auth Models
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// BUSINESS ENTITIES
// ==========================================

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyName String?
  source      String?
  type        LeadType   @default(GENERAL)
  status      LeadStatus @default(NEW)
  message     String?    @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  nextActionAt DateTime?
  lostReason   String?

  demos ProductDemo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  businessName   String?
  documentType   String?
  documentNumber String?
  email          String?
  phone          String?
  whatsapp       String?
  website        String?
  address        String?
  status         ClientStatus @default(PROSPECT)

  responsibleWorkerId String?
  responsibleWorker   User?   @relation("ResponsibleWorkerClients", fields: [responsibleWorkerId], references: [id], onDelete: SetNull)

  users     User[]            @relation("ClientUsers")
  projects  Project[]
  documents Document[]
  payments  PaymentSchedule[]
  demos     ProductDemo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([responsibleWorkerId])
}

model Project {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  name        String
  description String?       @db.Text
  type        ProjectType
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0) // 0 - 100

  startDate        DateTime?
  estimatedEndDate DateTime?
  deliveredAt      DateTime?

  price Decimal @default(0) @db.Decimal(10, 2)

  responsibleWorkerId String?
  responsibleWorker   User?   @relation("ResponsibleWorkerProjects", fields: [responsibleWorkerId], references: [id], onDelete: SetNull)

  milestones ProjectMilestone[]
  documents  Document[]
  payments   PaymentSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([responsibleWorkerId])
}

model ProjectMilestone {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  order       Int             @default(0)

  dueDate     DateTime?
  completedAt DateTime?

  visibleToClient Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Document {
  id String @id @default(cuid())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  type         DocumentType @default(OTHER)
  originalName String
  storedName   String
  mimeType     String
  size         Int // size in bytes

  storageProvider String // e.g., 'local', 's3', 'r2'
  storageKey      String // Relative path or S3 key (NOT absolute path)
  publicUrl       String?

  visibleToClient Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([uploadedById])
}

model PaymentSchedule {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  concept  String
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  status PaymentStatus @default(PENDING)

  dueDate DateTime?
  paidAt  DateTime?
  notes   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  status      String  @default("ACTIVE")

  demos ProductDemo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductDemo {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("AssignedDemos", fields: [assignedToId], references: [id], onDelete: SetNull)

  companyName  String?
  contactName  String?
  contactEmail String?
  contactPhone String?

  status DemoStatus @default(DEMO_REQUESTED)

  demoDate     DateTime?
  nextActionAt DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([leadId])
  @@index([clientId])
  @@index([assignedToId])
}

model ActivityLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  entityType  String
  entityId    String
  action      String
  description String? @db.Text

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model InternalSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
